{
  "expo": {
    "name": "StreamScout",
    "slug": "streamscout",
    "scheme": "streamscout",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#140e10",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fwiman.streamscout",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.fwiman.streamscout",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#21171a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "StreamScout",
      "shortName": "StreamScout",
      "description": "Find movies and TV shows and see where to stream them in Sweden.",
      "themeColor": "#140e10",
      "backgroundColor": "#140e10",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-apple-authentication"
    ],
    "description": "Find movies and TV shows and see where to stream them in Sweden.",
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba4592fb-65de-4674-bbba-1125792756a0"
      }
    },
    "owner": "wiman"
  }
}
