{
  "expo": {
    "name": "StreamWatch",
    "slug": "streamwatch",
    "scheme": "streamwatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fwiman.streamwatch",
      "usesAppleSignIn": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.fwiman.streamwatch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8b5cf6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "StreamWatch",
      "shortName": "StreamWatch",
      "description": "Find movies and TV shows and see where to stream them in Sweden.",
      "themeColor": "#0b0d12",
      "backgroundColor": "#0b0d12",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-apple-authentication"
    ],
    "description": "Find movies and TV shows and see where to stream them in Sweden.",
    "icon": "./assets/icon.png"
  }
}
