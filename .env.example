# Kopiera den här filen till .env och fyll i din nyckel.
# Hämta en API-nyckel (v3) på https://www.themoviedb.org/settings/api
# OBS: EXPO_PUBLIC_-variabler byggs in i appen och syns för användare.
# Senare flyttar vi anropen till en egen backend så att nyckeln kan döljas.
EXPO_PUBLIC_TMDB_API_KEY=

# Supabase (konton och watchlist) – från Supabase-projektet under
# Project Settings → API (eller "Connect"): Project URL och Publishable key.
# Den publika nyckeln får finnas i appen; åtkomst styrs av databasens säkerhetsregler.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sätt till true när Google-inloggning är uppsatt i Supabase (se README).
EXPO_PUBLIC_AUTH_GOOGLE=false
