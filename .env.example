# Copy this file to .env and fill in your keys.
# Get an API key (v3) at https://www.themoviedb.org/settings/api
# NOTE: EXPO_PUBLIC_ variables are built into the app and visible to users.
# Later we'll move the requests to our own backend so the key can be hidden.
EXPO_PUBLIC_TMDB_API_KEY=

# Supabase (accounts and watchlist) – from the Supabase project under
# Project Settings → API (or "Connect"): Project URL and Publishable key.
# The publishable key may ship in the app; access is controlled by the database's security rules.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sign-in buttons – set to true once each method is set up in Supabase (see README).
EXPO_PUBLIC_AUTH_GOOGLE=false
# Apple on iPhone (free, works in Expo Go)
EXPO_PUBLIC_AUTH_APPLE=false
# Apple on web and Android (needs a paid Apple Developer account)
EXPO_PUBLIC_AUTH_APPLE_WEB=false
