{
  "name": "streamscout",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "expo install expo-router expo-linking expo-constants expo-status-bar expo-image expo-web-browser expo-linear-gradient @expo/vector-icons @expo/metro-runtime react react-dom react-native react-native-web react-native-safe-area-context react-native-screens @tanstack/react-query @supabase/supabase-js expo-sqlite expo-apple-authentication expo-crypto && expo install --fix && expo install typescript @types/react -- --save-dev",
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "expo export --platform web",
    "deploy:web": "expo export --platform web && eas deploy --prod"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/react": "~19.3.0",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3"
  }
}
